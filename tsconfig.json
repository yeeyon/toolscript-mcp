{
  // src/core must stay pure: `types: []` loads no Node types, so an import of a
  // Node module or a host package fails the build. The host code (src/host)
  // builds with tsconfig.host.json.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/core"]
}
