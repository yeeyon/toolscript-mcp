{
  "name": "toolscript-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone MCP server for code mode: the model writes one JavaScript program that calls your MCP tools in a sandbox.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "sandbox"
  ],
  "author": "yeeyon (https://github.com/yeeyon)",
  "contributors": [
    "Gabriele Pavanello (https://github.com/gabe4coding)"
  ],
  "homepage": "https://github.com/yeeyon/toolscript-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeeyon/toolscript-mcp.git"
  },
  "bugs": "https://github.com/yeeyon/toolscript-mcp/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "toolscript-mcp": "dist/host/main.js"
  },
  "files": [
    "dist",
    "runtime",
    "hints",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check": "node tests/docs.check.mjs && node tests/code.check.mjs",
    "format": "sh scripts/format.sh --write ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
