    ["submit pending review", "mcp__github__pull_request_review_write"],
    ["resolve thread", "mcp__github__pull_request_review_write"],
    ["get review comments", "mcp__github__pull_request_read"],
    ["get workflow run usage", "mcp__github__actions_get"]
  ]
