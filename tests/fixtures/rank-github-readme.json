{
  "servers": {
    "github": [
      [
        "actions_get",
        "Get details of GitHub Actions resources (workflows, workflow runs, jobs, and artifacts)",
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "get_workflow",
                "get_workflow_run",
                "get_workflow_job",
                "download_workflow_run_artifact",
                "get_workflow_run_usage",
                "get_workflow_run_logs_url"
              ]
            },
            "owner": { "type": "string" },
            "repo": { "type": "string" },
            "resource_id": { "type": "string" }
          },
          "required": ["method", "owner", "repo", "resource_id"]
        }
      ],
      [
        "actions_list",
        "List GitHub Actions workflows in a repository",
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": ["list_workflows", "list_workflow_runs", "list_workflow_jobs", "list_workflow_run_artifacts"]
            },
            "owner": { "type": "string" },
            "repo": { "type": "string" },
            "page": { "type": "number", "minimum": 1 },
            "perPage": { "type": "number", "minimum": 1, "maximum": 100 },
            "resource_id": { "type": "string" },
            "workflow_jobs_filter": { "type": "object" },
            "workflow_runs_filter": { "type": "object" }
          },
          "required": ["method", "owner", "repo"]
        }
      ],
      ["get_job_logs", "Get GitHub Actions workflow job logs"],
      ["get_me", "Get my user profile"],
      ["get_teams", "Get teams"],
      ["assign_copilot_to_issue", "Assign Copilot to issue"],
      ["request_copilot_review", "Request Copilot review"],
      ["list_code_scanning_alerts", "List code scanning alerts"],
      ["list_dependabot_alerts", "List dependabot alerts"],
      ["discussion_comment_write", "Manage discussion comments"],
      ["get_discussion_comments", "Get discussion comments"],
      ["list_discussions", "List discussions"],
      ["create_gist", "Create Gist"],
      ["get_repository_tree", "Get repository tree"],
      ["add_issue_comment", "Add comment to issue or pull request"],
      ["get_label", "Get a specific label from a repository"],
      ["issue_read", "Get issue details"],
      ["issue_write", "Create or update issue/pull request"],
      ["list_issues", "List issues"],
      ["search_issues", "Search issues"],
      ["sub_issue_write", "Change sub-issue"],
      ["update_issue_comment", "Update issue comment"],
      ["list_notifications", "List notifications"],
      ["search_orgs", "Search organizations"],
      ["projects_list", "List GitHub Projects resources"],
      ["add_comment_to_pending_review", "Add review comment to the requester's latest pending pull request review"],
      ["add_reply_to_pull_request_comment", "Add reply to pull request comment"],
      ["create_pull_request", "Open new pull request"],
      ["list_pull_requests", "List pull requests"],
      ["merge_pull_request", "Merge pull request"],
      [
        "pull_request_read",
        "Get details for a single pull request",
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "get",
                "get_diff",
                "get_status",
                "get_files",
                "get_commits",
                "get_review_comments",
                "get_reviews",
                "get_comments",
                "get_check_runs"
              ]
            },
            "owner": { "type": "string" },
            "pullNumber": { "type": "number" },
            "repo": { "type": "string" },
            "after": { "type": "string" },
            "page": { "type": "number", "minimum": 1 },
            "perPage": { "type": "number", "minimum": 1, "maximum": 100 }
          },
          "required": ["method", "owner", "pullNumber", "repo"]
        }
      ],
      [
        "pull_request_review_write",
        "Write operations (create, submit, delete) on pull request reviews",
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": ["create", "submit_pending", "delete_pending", "resolve_thread", "unresolve_thread"]
            },
            "owner": { "type": "string" },
            "pullNumber": { "type": "number" },
            "repo": { "type": "string" },
            "body": { "type": "string" },
            "commitID": { "type": "string" },
            "event": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"] },
            "resolutionReason": { "type": "string", "enum": ["addressed", "wont-fix", "invalid"] },
            "threadId": { "type": "string" }
          },
          "required": ["method", "owner", "pullNumber", "repo"]
        }
      ],
      ["search_pull_requests", "Search pull requests"],
      ["update_pull_request", "Edit pull request"],
      ["update_pull_request_branch", "Update pull request branch"],
      ["create_pull_request_with_copilot", "Perform task with GitHub Copilot coding agent"]
    ]
  },
  "queries": [
    ["resolve review thread", "mcp__github__pull_request_review_write"],
    ["submit pending pr review", "mcp__github__pull_request_review_write"],
    ["list workflow runs", "mcp__github__actions_list"],
    ["list workflow run artifacts", "mcp__github__actions_list"],
    ["workflow run logs url", "mcp__github__actions_get"],
    ["download workflow run artifact", "mcp__github__actions_get"],
